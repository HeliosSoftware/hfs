# HFS FHIR UI — environment variables
#
# Copy this file to .env.local and fill in the values for your IdP.
# All VITE_* variables are embedded in the browser bundle at build time.

# Base URL of the HFS FHIR server.
# In development the Vite proxy rewrites /api/* → http://localhost:8080/*,
# so the default /api works without extra CORS setup.
# In production, set this to the full HFS URL (e.g., https://hfs.example.com).
VITE_HFS_BASE_URL=/api

# OAuth2 client ID registered in your IdP as a public SPA application.
# For the local Keycloak dev setup, this is pre-configured as "hfs-ui".
VITE_OIDC_CLIENT_ID=hfs-ui

# Space-separated SMART scopes to request from the IdP.
# Must be a subset of the scopes your client is allowed to request.
VITE_OIDC_SCOPES=openid profile user/*.rs
