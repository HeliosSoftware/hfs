      },
      {
        "id": "Patient.maritalStatus",
        "path": "Patient.maritalStatus",
        "patternCodeableConcept": { "coding": [{ "system": "http://x" }] }
      },
      {
        "id": "Patient.extension:race",
        "path": "Patient.extension",
        "sliceName": "race",
        "min": 1,
        "max": "1",
        "type": [
          {
            "code": "Extension",
            "profile": ["http://example.org/StructureDefinition/race"]
          }
        ]
      }
    ]
