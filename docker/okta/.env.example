# Okta configuration for HFS FHIR Server
#
# This file documents the environment variables needed to connect HFS to Okta
# for both SMART Backend Services (machine-to-machine) and the browser UI (SMART App Launch).
#
# Setup steps:
#   1. Create a custom Authorization Server (Security → API → Add Authorization Server)
#      - Name: HFS FHIR
#      - Audience: https://hfs.example.com
#      - Note the Authorization Server ID (e.g., aus1abc2defGHIJK)
#
#   2. Add SMART scopes to the authorization server (Scopes tab)
#      Add: system/*.cruds, user/*.cruds, user/*.rs,
#           patient/Patient.r, patient/Observation.rs
#
#   3. Add groups and a groups claim (Claims tab)
#      - Claim name: groups
#      - Include in token type: Access Token
#      - Value type: Groups
#      - Filter: Matches regex .*
#
#   4. Add a SMART scope claim via an inline hook or claim expression
#      To map Okta groups to SMART scopes automatically, add a custom claim:
#      - Claim name: scope (or add to existing scp)
#      - Expression (example for fhir-admin group → user/*.cruds):
#          isMemberOfGroupName("fhir-admin") ? "user/*.cruds" : ""
#      For multiple scopes, use a custom token inline hook or Expression Language.
#
#   5. Create an API Services application for backend services
#      (Applications → Create App Integration → API Services)
#      - Assign to your custom authorization server
#      - Set OKTA_CLIENT_ID and OKTA_CLIENT_SECRET from this app
#
#   6. Create a Single Page App for the browser UI
#      (Applications → Create App Integration → OIDC - OpenID Connect → Single-Page Application)
#      - Sign-in redirect URIs: http://localhost:5173/callback
#      - Sign-out redirect URIs: http://localhost:5173
#      - Trusted Origins: http://localhost:5173
#      - PKCE is required for SPAs — no client secret
#      - Set UI_OKTA_CLIENT_ID from this app
#
# For more details see: https://developer.okta.com/docs/guides/implement-grant-type/authcode-pkce/main/

# ── Backend Services (client_credentials flow) ──────────────────────────────
OKTA_DOMAIN=dev-12345678.okta.com
OKTA_AUTH_SERVER_ID=aus1abc2defGHIJK
OKTA_CLIENT_ID=<api-services app client id>
OKTA_CLIENT_SECRET=<api-services app client secret>
OKTA_SCOPE=system/*.cruds

# ── Browser UI (authorization_code + PKCE) ───────────────────────────────────
# Client ID of the Single Page Application — no secret for public clients
UI_OKTA_CLIENT_ID=<spa app client id>

# ── HFS Server environment variables ─────────────────────────────────────────
HFS_AUTH_ENABLED=true
HFS_AUTH_JWKS_URL=https://${OKTA_DOMAIN}/oauth2/${OKTA_AUTH_SERVER_ID}/v1/keys
HFS_AUTH_ISSUER=https://${OKTA_DOMAIN}/oauth2/${OKTA_AUTH_SERVER_ID}
HFS_AUTH_AUDIENCE=https://hfs.example.com

# SMART discovery endpoints (shown in /.well-known/smart-configuration)
HFS_SMART_AUTHORIZE_ENDPOINT=https://${OKTA_DOMAIN}/oauth2/${OKTA_AUTH_SERVER_ID}/v1/authorize
HFS_SMART_TOKEN_ENDPOINT=https://${OKTA_DOMAIN}/oauth2/${OKTA_AUTH_SERVER_ID}/v1/token
HFS_SMART_JWKS_URL=https://${OKTA_DOMAIN}/oauth2/${OKTA_AUTH_SERVER_ID}/v1/keys

# Allow the UI origin (adjust for production)
HFS_CORS_ORIGINS=http://localhost:5173
