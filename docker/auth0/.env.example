# Auth0 configuration for HFS FHIR Server
#
# This file documents the environment variables needed to connect HFS to Auth0
# for both SMART Backend Services (machine-to-machine) and the browser UI (SMART App Launch).
#
# Setup steps:
#   1. Create an API in Auth0 (Applications → APIs → Create API)
#      - Name: HFS FHIR API
#      - Identifier (audience): https://hfs.example.com
#      - Signing Algorithm: RS256
#
#   2. Create a Machine-to-Machine Application for backend services
#      (Applications → Applications → Create Application → Machine to Machine)
#      - Authorize it against your HFS FHIR API
#      - Grant the SMART scopes you need (system/*.cruds, etc.)
#      - Set AUTH0_CLIENT_ID and AUTH0_CLIENT_SECRET from this app
#
#   3. Create a Single Page Application for the browser UI
#      (Applications → Applications → Create Application → Single Page Application)
#      - Add Allowed Callback URLs: http://localhost:5173/callback
#      - Add Allowed Logout URLs:   http://localhost:5173
#      - Add Allowed Web Origins:   http://localhost:5173
#      - PKCE is enabled automatically for SPAs — no client secret needed
#      - Set UI_AUTH0_CLIENT_ID from this app
#
#   4. Add SMART scope definitions to the API
#      (APIs → HFS FHIR API → Permissions tab)
#      Add permissions: system/*.cruds, user/*.cruds, user/*.rs,
#                       patient/Patient.r, patient/Observation.rs, etc.
#
#   5. Map Auth0 roles to SMART scopes via an Action (Actions → Flows → Login)
#      Example action to include roles as SMART scopes:
#
#        exports.onExecutePostLogin = async (event, api) => {
#          const roles = event.authorization?.roles ?? [];
#          const scopeMap = {
#            'fhir-admin':   'user/*.cruds',
#            'fhir-reader':  'user/*.rs',
#            'fhir-patient': 'patient/Patient.r patient/Observation.rs',
#          };
#          const smartScopes = roles.flatMap(r => (scopeMap[r] ?? '').split(' ')).filter(Boolean);
#          if (smartScopes.length > 0) {
#            api.accessToken.setCustomClaim('scope',
#              (event.transaction?.requested_scopes ?? []).concat(smartScopes).join(' '));
#          }
#        };
#
# For more details see: https://auth0.com/docs/get-started/apis/scopes/add-custom-claims-to-tokens

# ── Backend Services (client_credentials flow) ──────────────────────────────
AUTH0_DOMAIN=dev-abc123.us.auth0.com
AUTH0_CLIENT_ID=<machine-to-machine app client id>
AUTH0_CLIENT_SECRET=<machine-to-machine app client secret>
AUTH0_AUDIENCE=https://hfs.example.com
AUTH0_SCOPE=system/*.cruds

# ── Browser UI (authorization_code + PKCE) ───────────────────────────────────
# Client ID of the Single Page Application — no secret for public clients
UI_AUTH0_CLIENT_ID=<spa app client id>

# ── HFS Server environment variables ─────────────────────────────────────────
HFS_AUTH_ENABLED=true
HFS_AUTH_JWKS_URL=https://${AUTH0_DOMAIN}/.well-known/jwks.json
HFS_AUTH_ISSUER=https://${AUTH0_DOMAIN}/
HFS_AUTH_AUDIENCE=https://hfs.example.com

# SMART discovery endpoints (shown in /.well-known/smart-configuration)
HFS_SMART_AUTHORIZE_ENDPOINT=https://${AUTH0_DOMAIN}/authorize
HFS_SMART_TOKEN_ENDPOINT=https://${AUTH0_DOMAIN}/oauth/token
HFS_SMART_JWKS_URL=https://${AUTH0_DOMAIN}/.well-known/jwks.json

# Allow the UI origin (adjust for production)
HFS_CORS_ORIGINS=http://localhost:5173
