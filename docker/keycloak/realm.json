{
  "id": "fhir",
  "realm": "fhir",
  "displayName": "Helios FHIR Server",
  "enabled": true,
  "sslRequired": "none",
  "loginTheme": "helios",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "bruteForceProtected": false,
  "accessTokenLifespan": 300,
  "clientScopes": [
    {
      "name": "system/*.cruds",
      "description": "Full system-level SMART access on all resource types",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "system/Patient.rs",
      "description": "Read and search Patient resources",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "system/Observation.r",
      "description": "Read-only access to Observation resources",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    }
  ],
  "clients": [
    {
      "clientId": "hfs-backend-client",
      "name": "HFS Backend Service (full access)",
      "description": "Service account client for SMART Backend Services — full CRUD+search access",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "hfs-backend-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "authorizationServicesEnabled": false,
      "protocol": "openid-connect",
      "defaultClientScopes": ["system/*.cruds"],
      "optionalClientScopes": ["system/Patient.rs", "system/Observation.r"],
      "protocolMappers": [
        {
          "name": "hfs-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "hfs-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "hfs-readonly-client",
      "name": "HFS Read-only Client",
      "description": "Service account client limited to reading Patient resources",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "hfs-readonly-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "authorizationServicesEnabled": false,
      "protocol": "openid-connect",
      "defaultClientScopes": ["system/Patient.rs"],
      "optionalClientScopes": ["system/Observation.r"],
      "protocolMappers": [
        {
          "name": "hfs-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "hfs-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "hfs-web",
      "name": "HFS Web UI (interactive login)",
      "description": "Public client for the browser Authorization Code + PKCE login flow (issue #198). Renders the Helios-themed Keycloak login screen.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:8080/ui/callback",
        "http://localhost:8080/*"
      ],
      "webOrigins": ["http://localhost:8080"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8080/*"
      }
    }
  ],
  "users": [
    {
      "username": "demo",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "User",
      "email": "demo@example.org",
      "credentials": [
        { "type": "password", "value": "demo", "temporary": false }
      ]
    }
  ]
}
